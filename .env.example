# Vancouver WA House Cleaning — Environment Variables
# Copy this file to .env.local and fill in all values
# Never commit .env.local to GitHub

# Supabase — pinned to 2.25.0, browser-only
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic — content generation scripts
ANTHROPIC_API_KEY=your_anthropic_api_key

# Tracking phone number (360 area code — Twilio)
NEXT_PUBLIC_TRACKING_PHONE=+1360XXXXXXX
NEXT_PUBLIC_TRACKING_PHONE_DISPLAY=(360) XXX-XXXX

# Site config
NEXT_PUBLIC_SITE_URL=https://vancouverwahousecleaning.com
NEXT_PUBLIC_SITE_NAME=Vancouver WA House Cleaning
